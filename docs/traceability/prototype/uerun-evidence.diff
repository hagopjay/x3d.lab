+WROTE = re.compile(r"X3DLAB: wrote (\S+) \((\d+) files?, ([\d.]+) s\)")
+
+
+def wrote_lines(text: str) -> list:
+    """The lab's own `X3DLAB: wrote <job> (<n> files, <s> s)` lines (x3dlab_render.py:326): one per still, with the
+    number of the line, so a still's `seconds` can be tied to the log line that reported it."""
+    out = []
+    for n, l in enumerate(text.splitlines(), 1):
+        m = WROTE.search(l)
+        if m:
+            out.append({"job": m.group(1), "files": int(m.group(2)), "seconds": float(m.group(3)), "line": n, "text": l.strip()[:400]})
+    return out
+
