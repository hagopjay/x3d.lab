<X3D profile="Interchange" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
<head><component name="Lighting" level="2"/><meta name="title" content="E2 Cornell box"/><meta name="description" content="Classic GI test: red left wall, green right wall, white floor/ceiling/back, a bright emissive ceiling panel and a PointLight under it, a tall box and a short box. X_ITE draws no bounce light; Lumen and the path tracer should bleed red and green onto the boxes."/><meta name="creator" content="HagopJay and Claude, x3d.lab G4 experiments, 15 Nov 2026"/></head>
<Scene>
<NavigationInfo headlight="false"/>
<Background skyColor="0 0 0"/>
<Viewpoint DEF="Front" description="Front" position="0 2.5 9.2" orientation="1 0 0 -0.02" fieldOfView="0.6435"/>
<PointLight global="true" location="0 4.6 0" intensity="12" attenuation="0 0 1" radius="20" color="1 0.9 0.78"/>
<Transform translation="0 -0.05 0"><Shape><Appearance><PhysicalMaterial baseColor="0.73 0.73 0.73" metallic="0" roughness="0.9"/></Appearance><Box size="5 0.1 5"/></Shape></Transform>
<Transform translation="0 5.05 0"><Shape><Appearance><PhysicalMaterial baseColor="0.73 0.73 0.73" metallic="0" roughness="0.9"/></Appearance><Box size="5 0.1 5"/></Shape></Transform>
