<Transform translation="2.55 2.5 0"><Shape><Appearance><PhysicalMaterial baseColor="0.14 0.45 0.091" metallic="0" roughness="0.9"/></Appearance><Box size="0.1 5 5"/></Shape></Transform>
<Transform translation="0 4.98 0"><Shape><Appearance><PhysicalMaterial baseColor="0 0 0" emissiveColor="1 0.92 0.8"/></Appearance><Box size="1.3 0.02 1.05"/></Shape></Transform>
<Transform translation="-0.85 1.5 -0.7" rotation="0 1 0 0.30"><Shape><Appearance><PhysicalMaterial baseColor="0.73 0.73 0.73" metallic="0" roughness="0.9"/></Appearance><Box size="1.5 3 1.5"/></Shape></Transform>
<Transform translation="0.9 0.75 0.75" rotation="0 1 0 -0.29"><Shape><Appearance><PhysicalMaterial baseColor="0.73 0.73 0.73" metallic="0" roughness="0.9"/></Appearance><Box size="1.5 1.5 1.5"/></Shape></Transform>
