<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Interchange" version="4.0">
  <head>
    <meta name="title" content="hello-xr: the Unity bridge smoke scene"/>
    <meta name="description" content="DEF/USE, animation by ROUTE, indexed geometry, a point cloud, lights and a viewpoint. Every node here is on the bridge's supported list."/>
  </head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight="false"/>
    <Background skyColor="0.04 0.05 0.12"/>
    <DirectionalLight direction="-0.4 -1 -0.6" intensity="1.1" color="1 0.95 0.9"/>
    <Viewpoint DEF="Cam" description="Front" position="0 1.4 6" orientation="0 0 1 0" fieldOfView="0.9"/>
    <Transform DEF="Floor" translation="0 -0.05 0">
      <Shape>
        <Appearance><Material diffuseColor="0.2 0.22 0.28"/></Appearance>
        <Box size="8 0.1 8"/>
      </Shape>
    </Transform>
    <Transform DEF="Spinner" translation="-2 0.8 0">
      <Shape DEF="CubeShape">
        <Appearance><Material DEF="CubeMat" diffuseColor="0.9 0.35 0.2" emissiveColor="0.05 0.01 0"/></Appearance>
        <Box size="1 1 1"/>
      </Shape>
    </Transform>
    <Transform translation="2 0.8 0" rotation="0 1 0 0.6"><Shape USE="CubeShape"/></Transform>
    <Transform translation="0 0.7 -1">
      <Shape>
        <Appearance><Material diffuseColor="0.2 0.6 0.9" transparency="0.25"/></Appearance>
        <Sphere radius="0.7"/>
      </Shape>
    </Transform>
    <Transform translation="0 0.5 2">
      <Shape>
        <Appearance><Material diffuseColor="0.3 0.8 0.4"/></Appearance>
        <IndexedFaceSet creaseAngle="0.8" coordIndex="0 1 2 -1 0 2 3 -1 0 3 4 -1 0 4 1 -1 4 3 2 1 -1">
          <Coordinate point="0 1 0  -0.6 0 0.6  0.6 0 0.6  0.6 0 -0.6  -0.6 0 -0.6"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <Transform translation="0 2.2 0" scale="0.8 0.8 0.8">
      <Shape>
        <Appearance><Material emissiveColor="1 1 1"/></Appearance>
        <PointSet>
          <Coordinate point="-1 0 0  -0.5 0.3 0  0 0.5 0  0.5 0.3 0  1 0 0  0 -0.5 0"/>
          <Color color="1 0 0  1 0.5 0  1 1 0  0 1 0  0 0.5 1  0.6 0 1"/>
        </PointSet>
      </Shape>
    </Transform>
    <TimeSensor DEF="Clock" cycleInterval="4" loop="true"/>
    <OrientationInterpolator DEF="SpinI" key="0 0.5 1" keyValue="0 1 0 0  0 1 0 3.14159  0 1 0 6.28318"/>
    <PositionInterpolator DEF="BobI" key="0 0.5 1" keyValue="-2 0.8 0  -2 1.4 0  -2 0.8 0"/>
    <ColorInterpolator DEF="PulseI" key="0 0.5 1" keyValue="0.9 0.35 0.2  0.2 0.7 0.9  0.9 0.35 0.2"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="SpinI" toField="set_fraction"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="BobI" toField="set_fraction"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="PulseI" toField="set_fraction"/>
    <ROUTE fromNode="SpinI" fromField="value_changed" toNode="Spinner" toField="set_rotation"/>
    <ROUTE fromNode="BobI" fromField="value_changed" toNode="Spinner" toField="set_translation"/>
    <ROUTE fromNode="PulseI" fromField="value_changed" toNode="CubeMat" toField="set_diffuseColor"/>
  </Scene>
</X3D>
